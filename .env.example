# SentinelFlow SOAR Platform — Environment Configuration Example

# Application Settings
APP_NAME=SentinelFlow SOAR Platform
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Database Configuration
# Local Docker example; replace credentials for real deployments.
DATABASE_URL=postgresql://soar_user:replace-this-password@postgres:5432/soar_db

# Security & JWT Configuration
# Generate a strong random key locally; never commit the real value.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Threat Intelligence API Keys (Optional)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Simulation & Safety Controls
# Keep simulation enabled until live integrations are explicitly reviewed.
SIMULATION_MODE=true
REQUIRE_APPROVAL_RISK_THRESHOLD=80

# Deployment checklist:
# 1. Replace DATABASE_URL credentials.
# 2. Generate and inject JWT_SECRET through the deployment environment.
# 3. Restrict CORS_ORIGINS to trusted origins.
# 4. Keep SIMULATION_MODE=true while developing/testing.
