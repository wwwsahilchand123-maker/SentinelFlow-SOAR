# SentinelFlow SOAR Platform — Environment Configuration Example

# Application Settings
APP_NAME=SentinelFlow SOAR Platform
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Database Configuration (PostgreSQL in production/Docker, SQLite fallback in standalone dev)
DATABASE_URL=postgresql://soar_user:soar_secure_password_123@postgres:5432/soar_db

# Security & JWT Configuration (Generate a strong 256-bit random key in production)
JWT_SECRET=change-this-to-a-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Threat Intelligence API Keys (Optional - Leave blank to use Mock Threat Intel Provider)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# CORS Configuration (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Simulation & Safety Controls
SIMULATION_MODE=true
REQUIRE_APPROVAL_RISK_THRESHOLD=80
